{
  "$comment": "Editorial paper explainer tokens. MEASURED values come from 6 reference videos (see references/COLOR_AND_TEXTURE.md); others are ESTIMATE. Framework-neutral: read this file from any renderer.",
  "canvas": { "width": 1920, "height": 1080, "fps": 24, "safeMarginPx": [90, 140], "centerX": 960 },
  "timing": {
    "drawingsPerSecond": 12,
    "note": "Graphics and graphic camera moves update 12x/s (on twos @24 fps). Live footage and fades to black are not stepped."
  },
  "color": {
    "paper": "#F6F5EA",
    "paperWarm": "#E5DDC6",
    "paperCollageCenter": "#F2E8DF",
    "paperCollageEdge": "#DED4CE",
    "agedPaper": "#C4BDB2",
    "kraft": "#AD987F",
    "deskGrey": "#D8D6D8",
    "newsprint": "#E7E0CF",
    "dark": "#12100D",
    "chalkboard": "#1E1C1F",
    "pillarbox": "#1F1F1F",
    "ink": "#201E18",
    "inkSoft": "#393733",
    "newsInk": "#3A3835",
    "textOnDark": "#E3E3E3",
    "highlight": "#F0E136",
    "highlightPure": "#F6EA00",
    "brush": "#F8E10F",
    "gold": "#EAB718",
    "captionYellowOnFootage": "#E4E704",
    "red": "#FC3828",
    "redDeep": "#8B1C1B",
    "dateTag": "#7D3130",
    "coral": "#E96450",
    "blue": "#50B7FE",
    "green": "#62C583",
    "pink": "#FF85C1",
    "purple": "#BA75BB",
    "slateBlue": "#698ACD",
    "grid": "#CDCCC2",
    "greyMap": "#99989B",
    "lowerThirdPlate": "#EEE4D8"
  },
  "colorRules": [
    "All text is ink on paper or ink on yellow (6-15:1 contrast).",
    "Red/blue/green/pink/purple are fills only; blue on paper is 2.0:1 and must never be text.",
    "One yellow element becomes active per beat."
  ],
  "type": {
    "families": {
      "serif": { "standIn": "Source Serif 4", "alternatives": ["Merriweather", "Newsreader"], "role": "voice: titles, chart titles, labels, quotes (italic)" },
      "sans": { "standIn": "Inter", "alternatives": ["Public Sans", "Archivo"], "role": "data labels, numbers" },
      "marker": { "standIn": "Permanent Marker", "alternatives": ["Gochi Hand", "Kalam"], "role": "annotations only" },
      "blackletter": { "standIn": "UnifrakturMaguntia", "role": "newspaper masthead" },
      "condensed": { "standIn": "Oswald", "role": "tabloid headlines" }
    },
    "scalePx": {
      "titleCard": { "font": 118, "weight": 900, "case": "upper", "capAfterPunch": 93, "lineHeight": 0.98 },
      "cardTitleInYellowBox": { "font": 100, "weight": 700 },
      "sectionHeader": { "font": 88, "weight": 700 },
      "chartTitle": { "font": 52, "weight": 600, "top": 92 },
      "legendLabel": { "font": 50, "weight": 600 },
      "dataLabel": { "font": 34, "weight": 500, "family": "sans" },
      "footageCaption": { "font": 48, "style": "italic", "color": "captionYellowOnFootage", "x": 230, "baseline": 955 },
      "lowerThirdName": { "font": 54, "weight": 700, "case": "upper", "x": 139, "plateTop": 814 },
      "lowerThirdRole": { "font": 42, "weight": 700, "style": "italic" },
      "annotation": { "font": 38, "family": "marker" },
      "newspaperHeadline": { "font": 92, "weight": 900, "case": "upper" },
      "newspaperBody": { "font": 22, "lineHeight": 1.38, "align": "justify" }
    }
  },
  "ease": {
    "$comment": "cubic-bezier control points (ESTIMATE fits). No reference move overshoots: never use bouncy springs.",
    "pop": [0.16, 0.7, 0.7, 1],
    "expo": [0.16, 1, 0.3, 1],
    "grow": [0.25, 1, 0.5, 1],
    "punch": [0.2, 0.8, 0.3, 1],
    "push": [0.7, 0, 0.4, 1],
    "tilt": [0.45, 0, 0.55, 1],
    "pan": [0.55, 0, 0.1, 1],
    "accel": [0.55, 0, 1, 0.45],
    "wipe": [0.37, 0, 0.63, 1],
    "mapZoom": [0.55, 0, 0.15, 1]
  },
  "durationsFramesAt24": {
    "popIn": [7, 18],
    "stickerSlap": 8,
    "highlightBlock": [9, 19],
    "highlightDocumentLine": [27, 34],
    "brushSwipe": 10,
    "barGrow": 30,
    "barStagger": [6, 8],
    "iconStagger": 2,
    "typeLabelFramesPerChar": 1,
    "typeTitleFramesPerChar": 1.6,
    "strokeDrawOn": [6, 12],
    "punchIn": { "frames": 16, "scale": 1.3, "ease": "punch" },
    "cameraPush": { "frames": [22, 76], "scale": [1.18, 1.8], "ease": "push" },
    "whipPan": { "frames": 14, "px": 309, "ease": "punch" },
    "lateralPan": { "frames": 68, "px": 1675, "ease": "pan" },
    "zoomThrough": { "inFrames": 24, "outScale": 1.29, "inEase": "accel", "outFrames": 28, "inScale": 1.82, "outEase": "punch" },
    "snapZoom": { "frames": 4, "scale": 1.22, "ease": "accel" },
    "holdCreepPer2Frames": [0.002, 0.004],
    "titleCreepPerFrame": 0.0013,
    "fadeToBlack": [29, 58]
  },
  "texture": {
    "grain": { "flat": 0, "subtleStdLevels": [1.1, 1.6], "strongStdLevels": [4, 5], "sizePx": [0.6, 1.1], "refreshPerSecond": 12, "monochrome": true, "screenLocked": true },
    "vignetteCornerDrop": { "flat": 0, "collage": [0.08, 0.15], "kraft": [0.05, 0.08], "falloffStartsAtHalfDiagonal": 0.4 },
    "paperTexture": "static (never boils by itself)",
    "boil": "A-A-B two-variant texture loop, variant B one drawing in three",
    "chromaticAberrationPx": [2, 3],
    "archivalGrade": "grayscale(1) + 5-8% warm tint, not sepia"
  },
  "shadow": {
    "cardLarge": "10px 12px 27px 2px rgba(0,0,0,.62)",
    "cardSmall": "4px 5px 10px 2px rgba(0,0,0,.5)",
    "paperSoft": "drop-shadow(3px 4px 8px rgba(0,0,0,.25))",
    "newsClipping": "drop-shadow(6px 8px 14px rgba(0,0,0,.4))",
    "lightDirection": "top-left (shadows fall down-right)"
  },
  "layerOrder": [
    "ground colour", "static paper texture", "grid patch", "ghost type 20%",
    "cards / cut-outs with shadow", "ink type", "highlighter (multiply)", "hand annotations",
    "magnifier / lens", "vignette (screen-locked)", "grain (screen-locked)", "pillarbox / watermark"
  ],
  "pacing": {
    "documentaryMedianShotSec": 1.45,
    "explainerMedianShotSec": 3.3,
    "graphicBeatEverySec": [2.5, 7.5],
    "collageEventEverySec": [1, 2],
    "montageBurstFramesAt24": [4, 12],
    "cutBeforePhraseFrames": 2
  },
  "sound": {
    "masterLufs": [-19, -18],
    "truePeakDbtp": [-2.5, -1.5],
    "bedUnderVoiceDb": [15, 23],
    "sfxPerMinute": [1, 6],
    "chapterGapSec": [0.3, 1.3],
    "sfxFiles": ["paper-rustle", "stamp-thunk", "brush-swish", "whoosh-snap", "whoosh-pan", "paper-slap"]
  }
}
