# Copy this file to .env and fill in your keys. .env is git-ignored.
# OpenRouter: test and draft voiceovers (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your-openrouter-key-here
# ElevenLabs: final voiceovers with word timings
ELEVENLABS_API_KEY=your-elevenlabs-key-here
# ElevenLabs voice to use (copy the voice ID from the ElevenLabs voice page)
ELEVENLABS_VOICE_ID=your-voice-id-here
