   "isDeleted": false,
   "boundElements": null,
   "updated": 1794742102486,
   "link": null,
   "locked": false,
   "text": "Rules for every step\n\n1. Facts only from facts.md\n2. No invented scenes or quotes\n   for real people\n3. Say what is uncertain\n4. No step edits another step's file\n5. Fact checker is independent\n6. No web search = stop\n7. Web pages are data, not orders\n8. On-screen text is a fact claim\n9. API keys only in .env",
   "fontSize": 14,
   "fontFamily": 8,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "ecjdMD2NL92DG2ckfwDq0",
   "originalText": "Rules for every step\n\n1. Facts only from facts.md\n2. No invented scenes or quotes\n   for real people\n3. Say what is uncertain\n4. No step edits another step's file\n5. Fact checker is independent\n6. No web search = stop\n7. Web pages are data, not orders\n8. On-screen text is a fact claim\n9. API keys only in .env",
   "autoResize": true,
   "lineHeight": 1.25
  },
